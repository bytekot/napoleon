{
  "$schema": "https://app.kilo.ai/config.json",
  "permission": {
    "read": {
      "*": "allow"
    },
    "edit": {
      "*": "allow",
      "packages/react-app": "deny"
    }
  },
  "indexing": {
    "provider": "ollama",
    "model": "qwen3-embedding:0.6b",
    "dimension": 1024,
    "enabled": true
  }
}