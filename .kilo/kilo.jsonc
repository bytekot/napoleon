{
  "$schema": "https://app.kilo.ai/config.json",
  "permission": {
    "read": {
      "*": "allow"
    },
    "edit": {
      "*": "allow",
      "packages/react-app": "deny"
    },
    "bash": {
      "pnpm check": "allow",
      "pnpm format": "allow",
      "pnpm lint": "allow",
      "pnpm format:check": "allow",
      "pnpm type-check": "allow",
      "pnpm vitest": "allow",
      "node --version": "allow"
    }
  },
  "indexing": {
    "provider": "ollama",
    "model": "qwen3-embedding:0.6b",
    "dimension": 1024,
    "enabled": true
  }
}